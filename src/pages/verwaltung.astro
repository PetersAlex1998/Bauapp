---
/**
 * VERWALTERTOOL – Einstiegsseite.
 * Die eigentliche Anwendung liegt in src/verwaltung/ (Datenmodell,
 * Speicher, Rechenlogik, Oberfläche). Diese Seite prüft nur die
 * Anmeldung und startet sie.
 */
import '@fontsource-variable/fraunces';
import '@fontsource-variable/instrument-sans';
import '../styles/global.css';
import '../styles/verwaltung.css';
import { site } from '../data/site';
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Verwaltung | {site.name}</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#12263f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="vw">
    <a class="skip" href="#inhalt">Zum Inhalt springen</a>
    <div id="verwaltung" class="vw-app">
      <noscript><p style="padding:2rem">Für das Verwaltertool muss JavaScript im Browser aktiviert sein.</p></noscript>
    </div>
    <script>
      import { starte } from '../verwaltung/app';
      import '../verwaltung/ansichten2';
      import '../verwaltung/ansichten3';
      import '../verwaltung/ansichten4';
      import '../verwaltung/ansichten5';
      import '../verwaltung/ansichten6';
      import '../verwaltung/ansichten7';
      import '../verwaltung/ansichten8';
      import '../verwaltung/ansichten9';
      import '../verwaltung/ansichten10';
      import '../verwaltung/ansichten11';
      import '../verwaltung/ansichten12';
      import '../verwaltung/ansichten13';
      import { api, abmelden, modus } from '../verwaltung/cloud';
      import { ladeVomServer } from '../verwaltung/speicher';

      const wurzel = document.getElementById('verwaltung')!;
      const nutzer = sessionStorage.getItem('hadie-verwaltung');
      const zumLogin = () => location.replace('/kundenlogin/');
      const raus = async () => { await abmelden(); location.assign('/kundenlogin/'); };
      const meldung = (text: string) => { wurzel.innerHTML = ''; const p = document.createElement('p'); p.style.cssText = 'padding:2rem;max-width:40rem'; p.textContent = text; wurzel.append(p); };

      (async () => {
        if (!nutzer) return zumLogin();
        if (modus() === 'server') {
          meldung('Daten werden geladen …');
          const ich = await api('ich');
          if (ich.status === 401 || !ich.json?.ok) { await abmelden(); return zumLogin(); }
          if (ich.json.rolle !== 'verwaltung') { location.replace('/kundenbereich/'); return; }
          sessionStorage.setItem('hadie-admin', ich.json.admin ? '1' : '');
          sessionStorage.setItem('hadie-2fa', ich.json.zweiFaktor ? '1' : '');
          try {
            if (!(await ladeVomServer())) { await abmelden(); return zumLogin(); }
          } catch {
            return meldung('Die Daten konnten nicht geladen werden. Bitte prüfen Sie Ihre Verbindung und laden Sie die Seite neu.');
          }
        }
        starte(wurzel, nutzer, raus);
      })();
    </script>
  </body>
</html>
