---
/**
 * KUNDENBEREICH – reine Beispielansicht (Dummy).
 * Alle Zahlen und Einträge sind erfundene Beispieldaten und als solche
 * gekennzeichnet. Hier dürfen keine echten Kundendaten stehen, solange
 * es keine echte Anmeldung mit Server gibt.
 */
import Seite from '../layouts/Seite.astro';
import { site } from '../data/site';

const kennzahlen = [
  { wert: '3', text: 'Objekte in Verwaltung' },
  { wert: '2', text: 'offene Vorgänge' },
  { wert: '5', text: 'neue Dokumente' },
  { wert: '1', text: 'anstehender Termin' },
];
const vorgaenge = [
  { titel: 'Heizungswartung', objekt: 'Beispielstraße 1', stand: 'Termin vereinbart', art: 'laufend' },
  { titel: 'Renovierung Wohnung 3', objekt: 'Beispielstraße 1', stand: 'In Arbeit', art: 'laufend' },
  { titel: 'Betriebskostenabrechnung', objekt: 'Musterweg 12', stand: 'Abgeschlossen', art: 'fertig' },
  { titel: 'Mieterwechsel Wohnung 2', objekt: 'Musterweg 12', stand: 'Abgeschlossen', art: 'fertig' },
];
const dokumente = ['Betriebskostenabrechnung (Beispiel)', 'Übergabeprotokoll (Beispiel)', 'Wartungsnachweis Heizung (Beispiel)', 'Versicherungsschein (Beispiel)'];
---
<Seite titel="Kundenbereich" beschreibung={`Kundenbereich von ${site.name}.`} noindex>
  <section class="seitenkopf dunkel">
    <div class="rahmen">
      <p class="marke">Kundenbereich</p>
      <h1>Ihre Immobilien im Blick</h1>
    </div>
  </section>
  <section class="abschnitt--eng abschnitt">
    <div class="rahmen vw" id="kunde-app" aria-live="polite"><p>Wird geladen …</p></div>
    <noscript><div class="rahmen"><p>Für den Kundenbereich muss JavaScript im Browser aktiviert sein.</p></div></noscript>
  </section>
</Seite>

<script>
  import '../styles/verwaltung.css';
  import { api, abmelden, modus } from '../verwaltung/cloud';
  import { ladeVomServer } from '../verwaltung/speicher';
  import { starteKunde } from '../verwaltung/kunde';

  const wurzel = document.getElementById('kunde-app')!;
  const nutzer = sessionStorage.getItem('hadie-kunde');
  const meldung = (text: string) => { wurzel.replaceChildren(Object.assign(document.createElement('p'), { textContent: text })); };
  const raus = async () => { await abmelden(); location.assign('/kundenlogin/'); };

  (async () => {
    if (!nutzer) return location.replace('/kundenlogin/');
    if (modus() !== 'server') {
      return meldung('Demo-Modus: Der Kundenbereich zeigt echte Daten erst auf dem Server. Hier gibt es keine Kundendaten.');
    }
    const ich = await api('ich');
    if (ich.status === 401 || !ich.json?.ok) { await abmelden(); return location.replace('/kundenlogin/'); }
    if (ich.json.rolle !== 'kunde') return location.replace('/verwaltung/');
    try {
      if (!(await ladeVomServer())) { await abmelden(); return location.replace('/kundenlogin/'); }
    } catch {
      return meldung('Die Daten konnten nicht geladen werden. Bitte prüfen Sie Ihre Verbindung und laden Sie die Seite neu.');
    }
    starteKunde(wurzel, nutzer, raus);
  })();
</script>
