---
import Seite from '../layouts/Seite.astro';
import Platzhalter from '../components/Platzhalter.astro';
import { site, demoZugang, verwaltungZugang } from '../data/site';
const zugaenge = [
  { nr: verwaltungZugang.nummer, pw: verwaltungZugang.passwort, rolle: 'verwaltung' },
  { nr: demoZugang.kundennummer, pw: demoZugang.passwort, rolle: 'kunde' },
];
---
<Seite titel="Kunden-Login" beschreibung={`Anmeldung zum Kundenbereich von ${site.name}.`} noindex>
  <section class="seitenkopf dunkel login">
    <div class="rahmen login__rahmen">
      <div>
        <p class="marke">Kundenbereich</p>
        <h1>Kunden-Login</h1>
        <p class="lead leise">Melden Sie sich mit Ihrer Kundennummer an, um Ihre Objekte, Dokumente und Vorgänge einzusehen. Die Verwaltung meldet sich hier ebenfalls an.</p>
      </div>

      <form class="formular login__formular" id="login" data-zugaenge={JSON.stringify(zugaenge)} novalidate>
        <div class="feld">
          <label for="l-nr">Kundennummer</label>
          <input id="l-nr" name="kundennummer" type="text" autocomplete="username" autocapitalize="characters" required aria-describedby="l-nr-hilfe" />
          <small id="l-nr-hilfe">Verwaltung: Nummer mit „V-“ davor.</small>
        </div>
        <div class="feld">
          <label for="l-pw">Passwort</label>
          <input id="l-pw" name="passwort" type="password" autocomplete="current-password" required />
        </div>
        <p class="formular__status" role="alert" data-art="fehler"></p>
        <div><button class="knopf knopf--voll" type="submit">Anmelden</button></div>
        <p class="formular__hinweis">Zugangsdaten vergessen? Rufen Sie uns an: <a href={`tel:${site.telefon.link}`}>{site.telefon.anzeige}</a></p>
        <Platzhalter>
          <p><strong>Demo-Zugang.</strong> Der Kundenbereich ist eine Vorschau mit Beispieldaten und noch keine echte Anmeldung. Kunde: {demoZugang.kundennummer} · Verwaltung: {verwaltungZugang.nummer} · Passwort jeweils {demoZugang.passwort}</p>
        </Platzhalter>
        <noscript><p class="formular__hinweis">Für die Anmeldung muss JavaScript im Browser aktiviert sein.</p></noscript>
      </form>
    </div>
  </section>
</Seite>

<script>
  // Zwei Nutzerarten: «V-…» = Verwaltung → Verwaltertool, sonst Kunde → Kundenbereich.
  const ZIEL = { verwaltung: ['hadie-verwaltung', '/verwaltung/'], kunde: ['hadie-kunde', '/kundenbereich/'] } as const;
  const formular = document.querySelector<HTMLFormElement>('#login');
  if (formular) {
    if (sessionStorage.getItem('hadie-verwaltung')) location.replace('/verwaltung/');
    else if (sessionStorage.getItem('hadie-kunde')) location.replace('/kundenbereich/');
    const zugaenge: { nr: string; pw: string; rolle: keyof typeof ZIEL }[] = JSON.parse(formular.dataset.zugaenge || '[]');
    const status = formular.querySelector<HTMLElement>('.formular__status')!;
    formular.addEventListener('submit', (e) => {
      e.preventDefault();
      const daten = new FormData(formular);
      const nr = String(daten.get('kundennummer') ?? '').replace(/\s/g, '').toUpperCase();
      const pw = String(daten.get('passwort') ?? '');
      const treffer = zugaenge.find((z) => z.nr.toUpperCase() === nr && z.pw === pw);
      if (treffer) {
        const [schluessel, ziel] = ZIEL[treffer.rolle];
        sessionStorage.setItem(schluessel, treffer.nr);
        location.assign(ziel);
      } else {
        status.textContent = 'Nummer oder Passwort stimmen nicht. Bitte prüfen Sie Ihre Eingabe.';
        formular.querySelector<HTMLInputElement>('#l-pw')!.value = '';
        formular.querySelector<HTMLInputElement>('#l-nr')!.focus();
      }
    });
  }
</script>
