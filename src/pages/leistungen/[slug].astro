---
import Seite from '../../layouts/Seite.astro';
import Kreis from '../../components/Kreis.astro';
import Kontaktband from '../../components/Kontaktband.astro';
import Platzhalter from '../../components/Platzhalter.astro';
import Katalog from '../../components/Katalog.astro';
import { leistungen, gradbereich } from '../../data/leistungen';
import { site } from '../../data/site';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const fotos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/bilder/*.{jpg,png}', { eager: true });
const foto = (datei: string) => fotos[`/src/assets/bilder/${datei}`]?.default;

export function getStaticPaths() {
  return leistungen.map((l, index) => ({ params: { slug: l.slug }, props: { index } }));
}
const { index } = Astro.props;
const l = leistungen[index];
const naechste = leistungen[(index + 1) % leistungen.length];
const vorige = leistungen[(index + leistungen.length - 1) % leistungen.length];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: l.titel,
    description: l.seoBeschreibung,
    provider: { '@id': new URL('/#unternehmen', Astro.site).href },
    areaServed: site.region.map((ort) => ({ '@type': 'AdministrativeArea', name: ort })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Startseite', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Leistungen', item: new URL('/leistungen/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: l.titel },
    ],
  },
];
---
<Seite titel={l.seoTitel} beschreibung={l.seoBeschreibung} schema={schema}>
  <section class="seitenkopf dunkel">
    <div class="rahmen seitenkopf__raster">
      <div>
        <nav class="brotkrumen" aria-label="Sie sind hier">
          <ol>
            <li><a href="/">Startseite</a></li>
            <li><a href="/leistungen/">Leistungen</a></li>
            <li aria-current="page">{l.titel}</li>
          </ol>
        </nav>
        <p class="marke">{gradbereich(index)} · {l.verb}</p>
        <h1>{l.titel}</h1>
        <p class="lead leise">{l.einleitung}</p>
      </div>
      <div class="seitenkopf__kreis">
        <Kreis aktiv={l.slug} titel={`Der 360°-Kreis von HaDie – hervorgehoben: ${l.titel}`} />
      </div>
    </div>
  </section>

  <section class="abschnitt" aria-labelledby="umfang">
    <div class="rahmen">
      <p class="marke">Auf einen Blick</p>
      <h2 id="umfang">Das übernehmen wir für Sie.</h2>
      <ul class="umfang" style="margin-top:2.5rem">
        {l.umfang.map((u) => (
          <li>
            <h3>{u.titel}</h3>
            <p>{u.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {l.bilder?.length ? (
    <section class="abschnitt abschnitt--eng" aria-labelledby="einblicke">
      <div class="rahmen">
        <p class="marke">Einblicke</p>
        <h2 id="einblicke">So sieht das Ergebnis aus.</h2>
        <ul class="galerie">
          {l.bilder.map((b) => foto(b.datei) && (
            <li class="galerie__eintrag">
              <figure>
                <Picture src={foto(b.datei)!} formats={['avif', 'webp']} widths={[480, 800, 1200, 1536]} sizes="(max-width: 36rem) 100vw, 50vw" alt={b.alt} loading="lazy" decoding="async" />
                <figcaption>{b.text}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ) : null}

  {l.kundenbereich && (
    <section class="abschnitt kundenbereich-zeigen" aria-labelledby="kundenbereich">
      <div class="rahmen">
        <div class="zweier kundenbereich-zeigen__kopf">
          <div class="spalte-text">
            <p class="marke">Ihr Kundenbereich</p>
            <h2 id="kundenbereich">Ihre Immobilie. Jederzeit im Blick.</h2>
            <p class="lead">Mit Ihrer Kundennummer melden Sie sich auf unserer Website an – am Computer oder am Handy. Dort sehen Sie, was rund um Ihre Immobilie passiert, ohne nachfragen zu müssen.</p>
          </div>
          <ul class="haken-liste">
            <li><strong>Mieteingänge der letzten 12 Monate</strong> – im Vergleich zum Soll aus den Mietverträgen</li>
            <li><strong>Vermietungsstand</strong> – wie viele Einheiten vermietet sind</li>
            <li><strong>Kosten nach Art</strong> – wofür im laufenden Jahr Geld ausgegeben wurde</li>
            <li><strong>Meldungen und Schäden</strong> – direkt melden und den Stand verfolgen</li>
            <li><strong>Rechnungen, Arbeiten und Dokumente</strong> – ansehen, drucken, nachlesen</li>
            <li><strong>Mehrere Objekte</strong> – gemeinsam oder einzeln betrachten</li>
          </ul>
        </div>
        <div class="kundenbereich-zeigen__bilder">
          <figure class="geraet geraet--pc">
            <div class="geraet__leiste" aria-hidden="true"><span></span><span></span><span></span></div>
            <Picture src={foto('kundenbereich-pc.png')!} formats={['avif', 'webp']} widths={[800, 1200, 1600, 2464]} sizes="(max-width: 52rem) 100vw, 70vw" alt="Kundenbereich am Computer: Begrüßung, vier Kennzahlen (Mieteingang des Monats, vermietete Einheiten, offene Rechnungen, offene Meldungen), Balkendiagramm der Mieteingänge der letzten 12 Monate mit Soll-Linie und Kosten nach Art" loading="lazy" decoding="async" />
          </figure>
          <figure class="geraet geraet--handy">
            <Picture src={foto('kundenbereich-handy.png')!} formats={['avif', 'webp']} widths={[390, 780]} sizes="(max-width: 52rem) 60vw, 22vw" alt="Kundenbereich am Handy mit Kennzahlen und Diagramm der Mieteingänge" loading="lazy" decoding="async" />
          </figure>
        </div>
        <figure class="geraet geraet--pc geraet--zweit">
          <div class="geraet__leiste" aria-hidden="true"><span></span><span></span><span></span></div>
          <Picture src={foto('kundenbereich-listen.png')!} formats={['avif', 'webp']} widths={[800, 1200, 1600, 2464]} sizes="(max-width: 52rem) 100vw, 70vw" alt="Kundenbereich: Liste der Meldungen und Schäden mit Status sowie Rechnungen mit Betrag, Fälligkeit und Stand" loading="lazy" decoding="async" />
        </figure>
        <p class="leise kundenbereich-zeigen__hinweis">Ansichten mit erfundenen Beispieldaten. Mieterdaten und interne Notizen sind für Eigentümer nicht sichtbar; die Daten liegen auf unserem Server in Deutschland.</p>
      </div>
    </section>
  )}

  <section class="abschnitt hell" aria-labelledby="katalog">
    <div class="rahmen">
      <div class="abschnittskopf">
        <p class="marke">Im Einzelnen</p>
        <h2 id="katalog">Alle Leistungen in diesem Bereich.</h2>
      </div>
      <Katalog gruppen={l.katalog} />
      {l.platzhalter && (
        <div style="margin-top:2rem"><Platzhalter><p>{l.platzhalter}</p></Platzhalter></div>
      )}
      <p class="katalog__fehlt">
        Nicht dabei, was Sie suchen? <a href="/kontakt/#anfrage">Fragen Sie uns</a> – oder nutzen Sie die
        <a href="/leistungen/#finder">Suche über alle Leistungen</a>.
      </p>
    </div>
  </section>

  <section class="abschnitt" aria-labelledby="zusammenspiel">
    <div class="rahmen">
      <p class="marke">Im Zusammenspiel</p>
      <h2 id="zusammenspiel" class="sr-only">Wie dieser Bereich mit den anderen zusammenhängt</h2>
      <p class="zitatblock" data-worte>{l.zusammenspiel}</p>
      <nav class="weiter" aria-label="Weitere Leistungsbereiche" style="margin-top:3rem">
        <a class="pfeil-link" href={`/leistungen/${naechste.slug}/`}>Weiter im Kreis: {naechste.titel}</a>
        <a href="/leistungen/">Alle vier Bereiche ansehen</a>
      </nav>
    </div>
  </section>

  <Kontaktband titel={`${l.titel}: Sprechen wir darüber.`} />
</Seite>
