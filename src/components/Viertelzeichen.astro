---
/** Kleines Kreis-Symbol, das eines der vier Viertel markiert. */
interface Props { index: number }
const { index } = Astro.props;
const U = 2 * Math.PI * 16;
---
<svg class="viertel__zeichen" viewBox="0 0 40 40" aria-hidden="true" style={`transform: rotate(${index * 90 - 90}deg)`}>
  <circle class="spur" cx="20" cy="20" r="16" fill="none" stroke-width="2"></circle>
  <circle class="bogen" cx="20" cy="20" r="16" fill="none" stroke-width="4" stroke-linecap="round" stroke-dasharray={`${U / 4 - 3} ${U}`} stroke-dashoffset="-1.5"></circle>
</svg>
